# Frontend (Vite) env — copie para apps/web/.env (gitignored) e preencha.
# O Vite carrega .env a partir DESTA pasta (apps/web), não da raiz do monorepo.
# ATENÇÃO: só variáveis com prefixo VITE_ são expostas ao client — e elas ficam
# EMBUTIDAS no bundle (públicas). Nunca coloque secrets aqui (sk_, tokens etc.).

# Clerk publishable key (é pública por design). Tem que ser do MESMO instance que o
# CLERK_SECRET_KEY do server: test↔test (dev local) ou live↔live (prod). Não misture.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# URL do backend (apps/server):
#   local  -> http://localhost:8787   (quando roda `bun run dev:api` / wrangler dev)
#   prod   -> https://api.dailify.mxrqz.com
VITE_API_URL=http://localhost:8787
