{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mewki",
  "version": "0.1.0",
  "identifier": "com.mewki.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "https://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mewki",
        "width": 800,
        "height": 600,
        "backgroundColor": "#000000",
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://challenges.cloudflare.com",
        "frame-src": "https://challenges.cloudflare.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.mewki.mxrqz.com",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mewki"]
      },
      "mobile": [
        {
          "scheme": ["https"],
          "host": "mewki.mxrqz.com",
          "pathPrefix": ["/auth/app", "/app/"],
          "appLink": true
        },
        {
          "scheme": ["mewki"],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
