# apps/server local dev secrets — copy to `apps/server/.env` and fill in.
# Wrangler 4 auto-loads `.env` (same dir as wrangler.toml) into the Worker `env` during `wrangler dev`.
# Do NOT create a `.dev.vars` too — if it exists, this `.env` is ignored.
# `.env` is gitignored; this `.example` is the committed template.

CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
# Signing secret do endpoint de webhook do Clerk (evento user.deleted) — começa com "whsec_".
CLERK_WEBHOOK_SECRET=""
# Web Push: gere com `bun run vapid` (apps/server). A pública é servida em GET /push/key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OPENAI_API_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_YEAR=""
STRIPE_PRICE_PROAI=""
STRIPE_PRICE_PROAI_YEAR=""

# CORS origin do dev local (o valor de prod fica em wrangler.toml [vars]).
# Tem que bater EXATO com a origem do vite: mkcert => https, strictPort 1420.
ALLOWED_ORIGIN="https://localhost:1420"
