# apps/server local dev secrets — copy to `apps/server/.env` and fill in.
# Wrangler 4 auto-loads `.env` (same dir as wrangler.toml) into the Worker `env` during `wrangler dev`.
# Do NOT create a `.dev.vars` too — if it exists, this `.env` is ignored.
# `.env` is gitignored; this `.example` is the committed template.

# Better Auth. Secret: `openssl rand -base64 32` (>= 32 chars). URL = origem pública do worker
# (local: a do `wrangler dev`, ex. http://localhost:8787).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"
# Turnstile do login por e-mail. Esta é a chave de TESTE da Cloudflare (sempre passa).
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Web Push: gere com `bun run vapid` (apps/server). A pública é servida em GET /push/key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OPENAI_API_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_YEAR=""
STRIPE_PRICE_MAX=""
STRIPE_PRICE_MAX_YEAR=""
# Google: login + integrações Agenda e Gmail, mesmo OAuth client "Web application". Redirect URIs
# autorizadas = <BETTER_AUTH_URL>/auth/callback/google (login) e
# <origem do app>/integrations/{google-calendar,gmail}/callback (rotas do SPA, não do worker).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Slack app (api.slack.com/apps, user token scopes). Redirect URL = <origem do app>/integrations/slack/callback.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# GitHub OAuth App (not a GitHub App: those can't read notifications). It takes one callback URL
# and accepts any redirect_uri below it: <origem do app>/ covers /integrations/github/callback and
# the Tauri app's /app/integrations/github/callback. One OAuth App per origin (localhost = its own).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Cifra os tokens de terceiros no D1. Gere com `openssl rand -base64 32`. Nunca troque o valor:
# tokens já gravados deixam de abrir — rotação é uma TOKEN_KEY_V2 nova (integrations/crypto.ts).
TOKEN_KEY_V1=""

# CORS origin do dev local (o valor de prod fica em wrangler.toml [vars]).
# Tem que bater EXATO com a origem do vite: mkcert => https, strictPort 1420.
ALLOWED_ORIGIN="https://localhost:1420"
