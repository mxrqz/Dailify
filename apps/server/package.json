{
  "name": "@dailify/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CI=1 wrangler d1 migrations apply dailify --local && wrangler dev",
    "deploy": "CI=1 wrangler d1 migrations apply dailify --remote && wrangler deploy",
    "vapid": "bun run scripts/vapid.ts",
    "test": "vitest run",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "check": "prettier --check src test && eslint src test && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@dailify/shared": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "better-auth": "1.7.25",
    "hono": "^4.12.33",
    "luxon": "^3.6.1",
    "nanoid": "^6.0.0",
    "openai": "^7.3.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/luxon": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.162.0"
  }
}
