{
  "name": "@dailify/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CI=1 wrangler d1 migrations apply dailify --local && wrangler dev",
    "deploy": "CI=1 wrangler d1 migrations apply dailify --remote && wrangler deploy",
    "vapid": "bun run scripts/vapid.ts",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src test scripts vitest.config.ts",
    "format": "prettier --write src test scripts vitest.config.ts",
    "format:check": "prettier --check src test scripts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@dailify/shared": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "better-auth": "1.7.25",
    "hono": "^4.12.33",
    "nanoid": "^6.0.0",
    "openai": "^7.3.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.162.0"
  }
}
