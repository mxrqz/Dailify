{
  "name": "dailify",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:frontend": "bun --filter @dailify/web dev",
    "dev:api": "bun --filter @dailify/server dev",
    "seed": "bun --filter @dailify/server seed",
    "build": "bun --filter @dailify/web build",
    "test": "bun --filter '*' test",
    "format": "prettier --write package.json eslint.config.js .github && bun --filter '*' format",
    "format:check": "prettier --check package.json eslint.config.js .github && bun --filter '*' format:check",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "check": "prettier --check package.json eslint.config.js .github && bun --filter '*' check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
