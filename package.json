{
  "name": "dailify",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:frontend": "bun --filter @dailify/web dev",
    "dev:api": "bun --filter @dailify/server dev",
    "build": "bun --filter @dailify/web build",
    "test": "bun --filter '*' test",
    "check": "bun --filter '*' check"
  }
}
