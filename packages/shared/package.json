{
  "name": "@dailify/shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "parser:failures": "bun src/parse-task.known-failures.gen.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "date-fns": "^4.1.0"
  }
}
